{
    "name": "yourname/stock-portfolio-tracker",
    "description": "A production‑ready PHP library for tracking stock portfolios.",
    "type": "library",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "monolog/monolog": "^3.3",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "StockPortfolioTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StockPortfolioTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "license": "MIT"
}